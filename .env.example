# =============================================================================
# TradingIA - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# =============================================================================
# ALPACA API (Required for live data and paper trading)
# =============================================================================
# Get your keys from: https://app.alpaca.markets/
ALPACA_API_KEY=your_api_key_here
ALPACA_SECRET_KEY=your_secret_key_here

# API endpoint (default: paper trading)
# For live trading, use: https://api.alpaca.markets
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# =============================================================================
# OPTIONAL SETTINGS
# =============================================================================

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Database path (default: data/trading.db)
# DATABASE_PATH=data/trading.db

# Cache directory (default: data/cache)
# CACHE_DIR=data/cache

# =============================================================================
# DASHBOARD AUTHENTICATION
# =============================================================================
# Password for dashboard access (leave empty to disable auth in development)
# DASHBOARD_PASSWORD=your_secure_password

# Set to 'false' to disable authentication entirely
DASHBOARD_AUTH_ENABLED=true

# API key for programmatic dashboard access
# DASHBOARD_API_KEY=your_api_key_here

# Session timeout in minutes (default: 30)
# SESSION_TIMEOUT_MINUTES=30

# =============================================================================
# ADVANCED (Usually not needed)
# =============================================================================

# API rate limiting (requests per minute)
# API_RATE_LIMIT=200

# Thread pool size for parallel processing
# MAX_WORKERS=4
# =============================================================================
# TELEGRAM NOTIFICATIONS (Optional)
# =============================================================================
# Get your bot token from @BotFather on Telegram
# TELEGRAM_BOT_TOKEN=your_bot_token_here
# TELEGRAM_CHAT_ID=your_chat_id_here

# =============================================================================
# AI AGENTS (Optional - for automated analysis)
# =============================================================================
# OpenAI API key for AI-powered analysis
# OPENAI_API_KEY=your_openai_key_here

# =============================================================================
# MLFLOW TRACKING (Optional)
# =============================================================================
# MLFLOW_TRACKING_URI=http://localhost:5000
# MLFLOW_EXPERIMENT_NAME=trading-experiments